            e.stopPropagation();
            const panel = document.getElementById(&#39;dropdownPanel&#39;);
            if(panel) panel.classList.toggle(&#39;show&#39;);
        }
        window.addEventListener(&#39;click&#39;, () =&gt; {
            const panel = document.getElementById(&#39;dropdownPanel&#39;);
            if(panel) panel.classList.remove(&#39;show&#39;);
        });
