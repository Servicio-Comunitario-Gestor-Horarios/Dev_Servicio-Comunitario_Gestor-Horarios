        const cancelModalBtn = document.getElementById(&#39;cancelModalBtn&#39;);
        const modalTitleText = document.getElementById(&#39;modalTitleText&#39;);
        const userForm = document.getElementById(&#39;userForm&#39;);
        
        // Setup &quot;Nuevo usuario&quot; button
        const newUserBtn = document.querySelector(&#39;.page-header .btn-primary&#39;);
        if(newUserBtn) {
            newUserBtn.addEventListener(&#39;click&#39;, () =&gt; {
                modalTitleText.textContent = &#39;Registrar Nuevo Usuario&#39;;
                document.querySelector(&#39;.modal-title .material-symbols-outlined&#39;).textContent = &#39;person_add&#39;;
                userForm.reset();
                modal.classList.add(&#39;active&#39;);
            });
        }

        // Setup Edit buttons on table rows
        document.querySelectorAll(&#39;.action-btn&#39;).forEach(btn =&gt; {
            const icon = btn.querySelector(&#39;.material-symbols-outlined&#39;);
            if(icon &amp;&amp; icon.textContent.trim() === &#39;edit&#39;) {
                btn.addEventListener(&#39;click&#39;, () =&gt; {
                    modalTitleText.textContent = &#39;Editar Usuario&#39;;
                    document.querySelector(&#39;.modal-title .material-symbols-outlined&#39;).textContent = &#39;edit&#39;;
                    // Aquí iría la lógica para cargar datos del usuario si fuera dinámico
                    modal.classList.add(&#39;active&#39;);
                });
            }
        });

        // Close functions
        const closeModal = () =&gt; {
            modal.classList.remove(&#39;active&#39;);
        };

        closeModalBtn.addEventListener(&#39;click&#39;, closeModal);
        cancelModalBtn.addEventListener(&#39;click&#39;, closeModal);

        // Click outside to close
        modal.addEventListener(&#39;click&#39;, (e) =&gt; {
            if(e.target === modal) {
                closeModal();
            }
        });
        
        // Form Save Event
        document.getElementById(&#39;saveUserBtn&#39;).addEventListener(&#39;click&#39;, () =&gt; {
            if (userForm.checkValidity()) {
                // Aquí iría la lógica del CRUD para guardar en BD
                alert(&#39;¡Usuario guardado exitosamente!&#39;);
                closeModal();
            } else {
                userForm.reportValidity();
            }
        });
        function closeDropdown() { const p = document.getElementById(&#39;dropdownPanel&#39;); if(p) p.classList.remove(&#39;show&#39;); }
