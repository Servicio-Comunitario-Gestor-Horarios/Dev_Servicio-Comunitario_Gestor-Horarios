        .user-role {
            font-size: 0.7rem;
            color: var(--text-muted);
        }

        /* --- CONTENT AREA --- */
        .content-area {
            flex: 1;
            padding: 25px 30px;
            overflow-y: hidden;
            background-image: radial-gradient(#cbd5e1 1px, transparent 1px);
            background-size: 30px 30px;
            display: flex;
            flex-direction: column;
        }

        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            margin-bottom: 20px;
        }

        .page-title h2 {
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 4px;
            letter-spacing: -0.5px;
        }

        .page-title p {
            color: var(--text-muted);
            font-size: 0.95rem;
        }

        .btn-primary {
            background-color: var(--primary-color);
            color: #ffffff;
            border: none;
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
            box-shadow: 0 4px 6px -1px rgba(30, 58, 138, 0.2);
        }
        
        .btn-primary:hover {
            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        /* --- VISUALIZATION PANEL --- */
        .visualization-panel {
            background-color: #e2e8f0; /* Grey background matching mockup */
            border-radius: 16px;
            padding: 16px 20px;
            display: flex;
            flex-direction: column;
            flex: 1;
            min-height: 0;
            box-shadow: inset 0 2px 10px rgba(0,0,0,0.05);
        }

        /* Filters */
        .filters-bar {
            display: flex;
            gap: 16px;
            margin-bottom: 16px;
            flex-wrap: wrap;
        }

        .filter-item {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .filter-item select {
            padding: 6px 12px;
            border-radius: 6px;
            border: 1px solid var(--border-light);
            background-color: white;
            font-family: inherit;
            font-size: 0.9rem;
            color: var(--text-dark);
            outline: none;
        }

        /* Split Content */
        .vis-content {
            display: flex;
            gap: 16px;
            flex: 1;
            min-height: 0;
        }

        /* Calendar Grid */
        .calendar-container {
            flex: 2.5; /* Takes up most space */
            background: var(--bg-panel);
            border-radius: 12px;
            display: flex;
            flex-direction: column;
            overflow-y: auto;
            border: 1px solid var(--border-light);
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: 80px repeat(5, 1fr);
            width: 100%;
        }

        .calendar-header-cell {
            background: #f8fafc;
            font-weight: 700;
            font-size: 0.85rem;
            text-align: center;
            padding: 12px 10px;
            border-bottom: 2px solid var(--border-light);
            border-right: 1px solid var(--border-light);
            color: var(--text-dark);
            position: sticky;
            top: 0;
            z-index: 5;
        }

        .time-col {
            font-weight: 600;
            font-size: 0.75rem;
            text-align: center;
            padding: 12px 10px;
            border-right: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
            color: var(--text-muted);
            background: white;
        }

        .calendar-cell {
            border-right: 1px solid var(--border-light);
            border-bottom: 1px solid var(--border-light);
            padding: 6px;
            min-height: 70px;
            background: white;
        }

        /* Class Blocks */
        .class-block {
            border-radius: 6px;
            padding: 8px;
            font-size: 0.75rem;
            line-height: 1.3;
            color: #0f172a;
            height: 100%;
            display: flex;
            flex-direction: column;
            justify-content: flex-start;
            font-weight: 500;
        }

        .class-block.blue { background-color: #bae6fd; }
        .class-block.green { background-color: #bbf7d0; }
        .class-block.red { background-color: #fecaca; }
        .class-block.yellow { background-color: #fef08a; }

        .block-title { font-weight: 700; }
        
        .break-block {
            justify-content: center;
            align-items: center;
            text-align: center;
            font-weight: 600;
        }

        /* Right Side Stats Panel */
        .stats-sidebar {
            flex: 1;
            display: flex;
            flex-direction: column;
            gap: 16px;
            min-width: 250px;
            overflow-y: auto; /* Enable scrolling for the sidebar if content is too tall */
        }

        .stat-card {
            background: var(--bg-panel);
            border-radius: 12px;
            padding: 20px;
            border: 1px solid var(--border-light);
            flex-shrink: 0; /* Prevent the card from shrinking too much and causing overlap */
        }

        .stat-card h4 {
            font-size: 1.05rem;
            margin-bottom: 15px;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: 10px;
            color: var(--text-dark);
        }

        /* Circular progress bars */
        .circular-progress-container {
            display: flex;
            justify-content: space-around;
            padding: 10px 0;
        }

        .circular-stat {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 12px;
            text-align: center;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--text-dark);
            width: 50%;
        }

        .circle-wrapper {
            position: relative;
            width: 80px;
            height: 80px;
        }

        /* Conic gradients for circles */
        .circle-progress.green { background: conic-gradient(#16a34a 100%, #e2e8f0 0); }
        .circle-progress.gray { background: conic-gradient(#e2e8f0 100%, #e2e8f0 0); } /* Represents 0 */

        .circle-progress {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .circle-progress::before {
            content: &quot;&quot;;
            position: absolute;
            inset: 8px;
            background-color: white;
            border-radius: 50%;
        }

        .circle-value {
            position: relative;
            z-index: 1;
            font-size: 1.25rem;
            font-weight: 700;
        }
        .circle-progress.green .circle-value { color: #16a34a; }
        .circle-progress.gray .circle-value { color: #22c55e; } /* In Mockup the &#39;0&#39; is green */

        /* Conflict table */
        .conflict-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.8rem;
        }
        .conflict-table th {
            text-align: left;
            padding: 8px 4px;
            border-bottom: 2px solid var(--border-light);
            color: var(--text-dark);
        }
        .conflict-table td {
            padding: 12px 4px; /* Reduced padding from 20px to save vertical space */
            color: var(--text-muted);
            text-align: center;
            font-style: italic;
            line-height: 1.4;
        }

        /* Bottom Action Bar */
        .bottom-action-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 16px;
            padding: 0 10px;
        }

        .back-link {
            font-size: 0.95rem;
            font-weight: 600;
            color: var(--text-dark);
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 4px;
            transition: color 0.2s;
        }
        .back-link:hover { color: var(--primary-color); }

        .action-buttons {
            display: flex;
            gap: 12px;
        }

        .btn-outline {
            background-color: transparent;
            color: var(--primary-color);
            border: 2px solid var(--primary-color);
            padding: 10px 20px;
            border-radius: 8px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s ease;
        }
        .btn-outline:hover {
            background-color: var(--primary-light);
        }

        /* TOAST NOTIFICATIONS */
        .toast-container {
            position: fixed;
            bottom: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 1000;
        }
        .toast {
            background: var(--bg-panel);
            border-left: 4px solid var(--primary-color);
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            padding: 16px 20px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 12px;
            transform: translateX(120%);
            transition: transform 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
            min-width: 300px;
        }
        .toast.show {
            transform: translateX(0);
        }
        .toast.success { border-left-color: #16a34a; }
        .toast.success .toast-icon { color: #16a34a; }
        .toast-icon {
            color: var(--primary-color);
            font-size: 1.5rem;
        }
        .toast-content h4 { font-size: 0.95rem; margin-bottom: 2px; color: var(--text-dark); }
        .toast-content p { font-size: 0.85rem; color: var(--text-muted); }

        /* EDIT MODE STYLE */
        .calendar-grid.edit-mode .class-block {
            cursor: grab;
            border: 2px dashed #64748b;
            box-shadow: 0 4px 6px rgba(0,0,0,0.05);
            opacity: 0.9;
        }
        .calendar-grid.edit-mode .class-block:hover {
            filter: brightness(0.95);
        }

    
        /* DROPDOWN PANEL STYLES */
        .menu-toggle { position: relative; }
        .dropdown-panel {
            position: absolute;
            top: 50px;
            left: 0;
            width: 220px;
            background: var(--bg-panel);
            border: 1px solid var(--border-light);
            border-radius: 8px;
            box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
            display: none;
            flex-direction: column;
            z-index: 1000;
            cursor: default;
            text-align: left;
        }
        .dropdown-panel.show { display: flex; }
        .dropdown-header {
            padding: 15px; border-bottom: 1px solid var(--border-light);
            display: flex; flex-direction: column; gap: 4px;
        }
        .dropdown-header strong { font-size: 0.9rem; color: var(--text-dark); line-height: 1.2; }
        .dropdown-header span { font-size: 0.75rem; color: var(--text-muted); }
        .dropdown-item {
            padding: 12px 15px; display: flex; align-items: center; gap: 10px;
            color: var(--text-dark); text-decoration: none; font-size: 0.85rem; font-weight: 500;
            transition: background 0.2s;
        }
        .dropdown-item:hover { background: var(--hover-bg); color: var(--primary-color); }
        .dropdown-divider { height: 1px; background: var(--border-light); margin: 5px 0; }
        .text-danger { color: #dc2626 !important; }
        .text-danger:hover { background: #fef2f2 !important; color: #dc2626 !important; }
    
        /* --- MODAL STYLES --- */
        .modal-overlay {
            position: fixed;
            top: 0; left: 0; right: 0; bottom: 0;
            background-color: rgba(15, 23, 42, 0.5);
            backdrop-filter: blur(4px);
            display: flex; align-items: center; justify-content: center;
            z-index: 9999;
            opacity: 0; pointer-events: none;
            transition: opacity 0.3s ease;
        }
        .modal-overlay.active {
            opacity: 1; pointer-events: auto;
        }
        .modal {
            background-color: var(--bg-panel, #ffffff);
            width: 100%; max-width: 600px;
            border-radius: 16px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
            transform: translateY(20px);
            transition: transform 0.3s ease;
            display: flex; flex-direction: column;
            overflow: hidden; border: 1px solid var(--border-light, #e2e8f0);
        }
        .modal-overlay.active .modal {
            transform: translateY(0);
        }
        .modal-header {
            padding: 20px 24px; border-bottom: 1px solid var(--border-light, #e2e8f0);
            display: flex; justify-content: space-between; align-items: center;
            background-color: #f8fafc;
        }
        .modal-title {
            font-size: 1.15rem; font-weight: 700; color: var(--text-dark, #0f172a);
            display: flex; align-items: center; gap: 8px;
        }
        .close-modal {
            background: transparent; border: none; color: var(--text-muted, #64748b);
            cursor: pointer; border-radius: 6px; width: 32px; height: 32px;
            display: flex; align-items: center; justify-content: center;
            transition: all 0.2s;
        }
        .close-modal:hover { background-color: #e2e8f0; color: var(--text-dark, #0f172a); }
        .modal-body { padding: 24px; max-height: 70vh; overflow-y: auto; background-color: var(--bg-panel, #ffffff); }
        .modal-footer {
            padding: 16px 24px; border-top: 1px solid var(--border-light, #e2e8f0);
            display: flex; justify-content: flex-end; gap: 12px; background-color: #f8fafc;
        }

    &lt;/style&gt;
&lt;/head&gt;
