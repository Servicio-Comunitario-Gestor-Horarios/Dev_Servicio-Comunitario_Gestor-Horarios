    &lt;script&gt;
        function showToast(title, message, isSuccess = false, duration = 3000) {
            const container = document.getElementById(&#39;toastContainer&#39;);
            const toast = document.createElement(&#39;div&#39;);
            toast.className = `toast ${isSuccess ? &#39;success&#39; : &#39;&#39;}`;
            
            const icon = isSuccess ? &#39;check_circle&#39; : &#39;info&#39;;
            
            toast.innerHTML = `
                &lt;span class=&quot;material-symbols-outlined toast-icon&quot;&gt;${icon}&lt;/span&gt;
                &lt;div class=&quot;toast-content&quot;&gt;
                    &lt;h4&gt;${title}&lt;/h4&gt;
                    &lt;p&gt;${message}&lt;/p&gt;
                &lt;/div&gt;
            `;
            
            container.appendChild(toast);
            
            // Trigger animation
            setTimeout(() =&gt; toast.classList.add(&#39;show&#39;), 10);
            
            // Remove
            setTimeout(() =&gt; {
                toast.classList.remove(&#39;show&#39;);
                setTimeout(() =&gt; toast.remove(), 300);
            }, duration);
        }

        function simulateDownload(btn) {
            btn.innerHTML = &#39;&lt;span class=&quot;material-symbols-outlined&quot; style=&quot;font-size: 1.2rem;&quot;&gt;sync&lt;/span&gt; Generando PDF...&#39;;
            showToast(&#39;Preparando Descarga&#39;, &#39;Generando documento PDF del horario...&#39;);
            
            setTimeout(() =&gt; {
                btn.innerHTML = &#39;&lt;span class=&quot;material-symbols-outlined&quot; style=&quot;font-size: 1.2rem;&quot;&gt;download&lt;/span&gt; Descargar Horario&#39;;
                showToast(&#39;Descarga Completa&#39;, &#39;El horario ha sido descargado exitosamente.&#39;, true);
            }, 2000);
        }

        function simulateSave(btn) {
            btn.innerHTML = &#39;&lt;span class=&quot;material-symbols-outlined&quot;&gt;sync&lt;/span&gt; Guardando...&#39;;
            showToast(&#39;Guardando Cambios&#39;, &#39;Actualizando la base de datos...&#39;);
            
            setTimeout(() =&gt; {
                btn.innerHTML = &#39;&lt;span class=&quot;material-symbols-outlined&quot;&gt;save&lt;/span&gt; Guardar Horario Actual&#39;;
                showToast(&#39;Horario Oficializado&#39;, &#39;El horario se ha guardado y publicado correctamente.&#39;, true);
            }, 1500);
        }

        let isEditMode = false;
        function toggleEditMode() {
            isEditMode = !isEditMode;
            const btn = document.getElementById(&#39;editBtn&#39;);
            const grid = document.querySelector(&#39;.calendar-grid&#39;);
            
            if (isEditMode) {
                btn.innerHTML = &#39;&lt;span class=&quot;material-symbols-outlined&quot;&gt;edit_off&lt;/span&gt; Salir de Edición&#39;;
                btn.style.backgroundColor = &#39;var(--primary-light)&#39;;
