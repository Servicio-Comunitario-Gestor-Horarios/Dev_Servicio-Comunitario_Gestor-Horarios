            background-color: var(--primary-hover);
            transform: translateY(-1px);
        }

        /* --- GRID LAYOUT --- */
        .management-grid {
            display: flex;
            gap: 20px;
            flex: 1;
            min-height: 0;
            padding-bottom: 10px;
        }

        /* --- TABLE PANEL --- */
        .table-panel {
            flex: 1; /* 100% width since there is no right panel */
            background: var(--bg-panel);
            border-radius: 12px;
            border: 1px solid var(--border-light);
