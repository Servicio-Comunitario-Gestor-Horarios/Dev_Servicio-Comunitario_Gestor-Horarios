    inline constexpr int RESP_ERROR         = -1;
    inline constexpr int RESP_NO_ENCONTRADO = -2;
    inline constexpr int RESP_TIEMPO_AGOTADO = -3;
    inline constexpr int RESP_INVALIDO      = -4;
