HEADER_RE = re.compile(r"^([0-9a-f]+)\|(.+?)\|(.+)$")
WEEK_RE = re.compile(r"Semana del (\d+) de (\w+) al (\d+) de (\w+) de (\d{4})")
APORTES_RE = re.compile(
