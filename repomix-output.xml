    &lt;script&gt;
        function startGeneration() {
            const modal = document.getElementById(&#39;processingModal&#39;);
            const message = document.getElementById(&#39;loadingMessage&#39;);
            const fill = document.getElementById(&#39;progressFill&#39;);
            const btn = document.getElementById(&#39;successBtn&#39;);
            const spinner = document.querySelector(&#39;.spinner&#39;);
            
            modal.classList.add(&#39;active&#39;);
            
            // Reset state
            fill.style.width = &#39;0%&#39;;
            btn.style.display = &#39;none&#39;;
            spinner.style.display = &#39;block&#39;;
            spinner.style.borderTopColor = &#39;var(--primary-color)&#39;;
            document.querySelector(&#39;.loading-title&#39;).textContent = &#39;Generando Horarios...&#39;;
            
            // Simulate algorithm progress
            setTimeout(() =&gt; { message.textContent = &#39;Analizando restricciones docentes...&#39;; fill.style.width = &#39;25%&#39;; }, 1000);
            setTimeout(() =&gt; { message.textContent = &#39;Cruzando disponibilidad de aulas...&#39;; fill.style.width = &#39;50%&#39;; }, 2500);
            setTimeout(() =&gt; { message.textContent = &#39;Resolviendo conflictos de asignaturas...&#39;; fill.style.width = &#39;75%&#39;; }, 4000);
            setTimeout(() =&gt; { 
                message.textContent = &#39;¡Horario generado exitosamente con 0 conflictos!&#39;; 
                fill.style.width = &#39;100%&#39;; 
                fill.style.backgroundColor = &#39;#166534&#39;;
                spinner.style.borderTopColor = &#39;#166534&#39;;
                
                // Show success
                setTimeout(() =&gt; {
                    spinner.style.display = &#39;none&#39;;
                    document.querySelector(&#39;.loading-title&#39;).textContent = &#39;¡Proceso Completado!&#39;;
                    document.querySelector(&#39;.loading-title&#39;).style.color = &#39;#166534&#39;;
                    btn.style.display = &#39;flex&#39;;
                }, 500);
            }, 5500);
        }

        function closeProcessingModal() {
            document.getElementById(&#39;processingModal&#39;).classList.remove(&#39;active&#39;);
            // Reset colors for next time
            setTimeout(() =&gt; {
                document.getElementById(&#39;progressFill&#39;).style.backgroundColor = &#39;var(--primary-color)&#39;;
                document.querySelector(&#39;.loading-title&#39;).style.color = &#39;var(--text-dark)&#39;;
            }, 300);
        }
    &lt;/script&gt;

