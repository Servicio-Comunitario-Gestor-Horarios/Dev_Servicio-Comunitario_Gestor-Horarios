{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml"
  },
  "include": [
    "**/*.{cpp,hpp,h,c,cc,qrc}",
    "**/CMakeLists.txt",
    "cmake/**/*.cmake",
    "CMakePresets.json",
    "config/*.json",
    "**/*.sh",
    "**/*.py",
    "*.bat"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": ["docs/**", "**/__pycache__/**", "*.pyc"]
  }
}
